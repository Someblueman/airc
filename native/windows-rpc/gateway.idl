[
    uuid(5b82e647-45c6-4c43-9359-2c97a440f225),
    version(1.0),
    explicit_handle,
    pointer_default(unique)
]
interface gateway
{
    typedef [range(0, 65536)] unsigned long response_length;

    error_status_t Exchange(
        [in] handle_t binding,
        [in, range(1, 16384)] unsigned long request_size,
        [in, size_is(request_size)] byte request[],
        [out] response_length *response_size,
        [out, length_is(*response_size)] byte response[65536]);
}
