[Unit]
Description=Deny TCP for the unprivileged AIRC UDP test account
After=ufw.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/airc-lab-guest.nft
ExecReload=/usr/sbin/nft -f /etc/airc-lab-guest.nft
ExecStop=/usr/sbin/nft delete table inet airc_guest_test
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
